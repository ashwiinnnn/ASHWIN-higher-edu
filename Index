      t.className='zoom-tile off' + (i===11?' me':'');
      t.innerHTML='<span class="dot"></span>';
      t.tabIndex=0;
      t.setAttribute('role','button');
      const toggle=()=>t.classList.toggle('off');
      t.addEventListener('click',toggle);
      t.addEventListener('keydown',e=>{ if(e.key==='Enter'||e.key===' '){e.preventDefault();toggle();} });
      zg.appendChild(t);
    }
  }

  // Receipt stamp: chapter 5
  const rWrap=document.getElementById('receipt-wrap');
  if(rWrap){
    const rIo=new IntersectionObserver((entries)=>{
      entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); rIo.unobserve(e.target); } });
    },{threshold:0.5});
    rIo.observe(rWrap);
  }

  // Split-flap board: chapter 8
  const flapBtn=document.getElementById('flap-btn');
  const flapRow=document.getElementById('flap-row');
  const flapCap=document.getElementById('flap-cap');
  if(flapBtn){
    const wrongStops=['PLATFORM 3','PLATFORM 5','WRONG LINE','PLATFORM 2'];
    const captions=[
      'Confidently boarded the wrong train.',
      'Realised two stops later.',
      'Walked back through a station I did not recognise, holding groceries.',
      'Finally, HAKATA. The right one. Every time, eventually.'
    ];
    let running=false;
    flapBtn.addEventListener('click', ()=>{
      if(running) return;
      running=true;
      flapCap.textContent='';
      let i=0;
      flapRow.innerHTML='<div class="flap wrong">'+wrongStops[0]+'</div>';
      const iv=setInterval(()=>{
        i++;
        if(i<wrongStops.length){
          flapRow.innerHTML='<div class="flap wrong">'+wrongStops[i]+'</div>';
          flapCap.textContent=captions[i-1];
        } else {
          clearInterval(iv);
          flapRow.innerHTML='<div class="flap right">HAKATA</div>';
          flapCap.textContent=captions[captions.length-1];
          running=false;
        }
      }, 650);
    });
  }
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>I almost didn't go to Japan — Ashwin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=Inter:wght@300;400;500;600;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --black:#0a0a0a; --white:#ffffff; --off:#f7f6f4; --grey:#6e6e6e;
    --grey-line:rgba(10,10,10,0.1); --red:#b23b30; --red-soft:rgba(178,59,48,0.08);
    --serif:'Source Serif 4', serif; --sans:'Inter', sans-serif; --hand:'Caveat', cursive;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0; background:var(--white); color:var(--black); font-family:var(--sans); overflow-x:hidden;}
  ::selection{background:var(--red); color:var(--white);}
  svg{display:block;}
  section{position:relative; padding:min(8vh,64px) 24px; max-width:680px; margin:0 auto;}
  .wide{max-width:920px;}
  p{font-size:18px; line-height:1.7; color:var(--black); text-align:justify; text-justify:inter-word; font-family:var(--serif); font-weight:400;}
  h2{font-family:var(--serif); font-weight:600; font-size:clamp(24px,3vw,32px); line-height:1.25; margin:0 0 .5em 0; text-align:left;}
  .eyebrow{font-family:var(--sans); font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--grey); margin-bottom:18px; font-weight:600; display:flex; align-items:center; gap:10px;}
  .eyebrow::before{content:""; width:22px; height:1px; background:var(--red);}
  .lede{font-family:var(--serif); font-size:clamp(20px,2.4vw,25px); font-weight:500; line-height:1.5; text-align:left; color:var(--black);}
  .reveal{opacity:0; transform:translateY(18px); transition:opacity .9s ease, transform .9s ease;}
  .reveal.in{opacity:1; transform:translateY(0);}
  .accent{color:var(--red);}
  .band{background:var(--off);}

  .quote-screen{min-height:100vh; max-width:none; display:flex; align-items:center; justify-content:center; padding:60px 28px; text-align:center;}
  .quote-screen.dark{background:var(--black); color:var(--white);}
  .quote-inner{max-width:780px;}
  .quote-mark{font-family:var(--serif); font-size:clamp(46px,8vw,90px); color:var(--red); line-height:1; margin-bottom:2px; opacity:0; transition:opacity 1s ease;}
  .quote-mark.in{opacity:1;}
  .quote-text{font-family:var(--serif); font-weight:500; font-size:clamp(24px,4vw,42px); line-height:1.32; text-align:center; opacity:0; transform:translateY(14px); transition:opacity 1s ease .2s, transform 1s ease .2s;}
  .quote-text.in{opacity:1; transform:translateY(0);}
  .quote-attr{margin-top:26px; font-family:var(--sans); font-size:13px; letter-spacing:.06em; color:#9a9a9a; opacity:0; transition:opacity 1s ease .5s;}
  .quote-attr.in{opacity:1;}
  .scroll-cue{position:absolute; bottom:36px; left:50%; transform:translateX(-50%); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--grey); font-family:var(--sans); opacity:0;}
  .scroll-cue.in{opacity:1; transition:opacity 1s ease 1s;}
  .scroll-cue::after{content:"↓"; display:block; margin-top:6px; animation:bob 1.8s ease-in-out infinite;}
  @keyframes bob{0%,100%{transform:translateY(0);}50%{transform:translateY(6px);}}

  .marg{position:relative;}
  .marg .hand-note{color:var(--red); font-family:var(--hand); font-size:19px; font-weight:600;}

  .exhibit{margin:24px 0; padding-left:18px; border-left:2px solid var(--red);}
  .exhibit .obj-name{font-family:var(--sans); font-size:13px; font-weight:600; color:var(--black); margin-bottom:4px;}
  .exhibit .obj-desc{font-family:var(--sans); font-size:14.5px; color:var(--grey); line-height:1.7; text-align:left;}

  #hero{min-height:100vh; max-width:none; display:flex; align-items:center; justify-content:center; background:var(--white); text-align:center; padding:60px 24px; position:relative;}
  #hero-inner{max-width:820px; position:relative; z-index:2;}
  .kicker{font-family:var(--sans); font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:var(--grey); margin-bottom:26px; opacity:0; transition:opacity 1s ease;}
  .kicker.in{opacity:1;}
  #hero h1{font-family:var(--serif); font-weight:600; font-size:clamp(32px,6vw,62px); line-height:1.15; color:var(--black); margin:0; opacity:0; transform:translateY(14px); transition:opacity 1s ease .15s, transform 1s ease .15s;}
  #hero h1.in{opacity:1; transform:translateY(0);}
  #hero h1 .accent{color:var(--red);}
  #hero .subtext{font-family:var(--sans); font-weight:400; font-size:clamp(15px,1.5vw,17px); color:var(--grey); margin:24px auto 0; max-width:520px; line-height:1.7; opacity:0; transition:opacity 1s ease .35s;}
  #hero .subtext.in{opacity:1;}
  .btn{display:inline-flex; align-items:center; gap:8px; font-family:var(--sans); font-size:14px; font-weight:600; color:var(--white); background:var(--black); border:none; padding:16px 30px; border-radius:100px; cursor:pointer; transition:transform .25s ease, background .25s ease; text-decoration:none; margin-top:40px;}
  .btn:hover{transform:translateY(-1px); background:var(--red);}
  .btn:focus-visible, a:focus-visible, button:focus-visible, [tabindex]:focus-visible{outline:2px solid var(--red); outline-offset:3px;}
  #hero .btn-wrap{opacity:0; transition:opacity 1s ease .55s;}
  #hero .btn-wrap.in{opacity:1;}
  .hero-doodle{position:absolute; opacity:.9;}
  .hero-stats{display:flex; gap:36px; justify-content:center; margin-top:32px; flex-wrap:wrap; opacity:0; transition:opacity 1s ease .7s;}
  .hero-stats.in{opacity:1;}
  .hstat{text-align:center;}
  .hnum{font-family:var(--serif); font-weight:700; font-size:clamp(28px,4vw,40px); color:var(--red); line-height:1;}
  .hlbl{font-family:var(--sans); font-size:11px; color:var(--grey); line-height:1.4; margin-top:8px; text-transform:uppercase; letter-spacing:.04em;}

  /* interactive: hero rejection/selection stamp */
  .stamp-interactive{margin:36px auto 0; text-align:center; cursor:pointer; opacity:0; transition:opacity 1s ease .5s; outline-offset:6px;}
  .stamp-interactive.in{opacity:1;}
  .stamp-face{display:inline-block; border:3px solid var(--red); color:var(--red); font-family:'Inter',sans-serif; font-weight:800; font-size:22px; letter-spacing:.14em; padding:14px 30px; transform:rotate(-5deg); transition:color .3s ease, border-color .3s ease, background-color .3s ease;}
  .stamp-face.slam{animation:stampSlam .4s cubic-bezier(.3,1.6,.4,1);}
  @keyframes stampSlam{0%{transform:scale(1.7) rotate(-5deg); opacity:.3;} 55%{transform:scale(.92) rotate(-5deg); opacity:1;} 100%{transform:scale(1) rotate(-5deg);}}
  .stamp-interactive.approved .stamp-face{border-color:var(--black); color:var(--white); background:var(--black);}
  .stamp-sub{margin-top:12px; font-family:var(--sans); font-size:12px; color:var(--grey); letter-spacing:.03em;}
  .stamp-hint{margin-top:10px; font-family:var(--sans); font-size:11px; color:#b4b0a6; text-align:center;}

  /* pull quote for breaking up text walls */
  .pull{font-family:var(--serif); font-size:clamp(22px,3.2vw,30px); font-weight:600; line-height:1.35; text-align:left; color:var(--black); margin:26px 0; padding:0 0 0 0;}
  .pull .accent{color:var(--red);}

  /* interactive: month tracker (chapter 6) */
  .month-tracker{margin:24px 0; background:var(--card, var(--paper)); border:1px solid var(--grey-line); padding:24px 22px;}
  .mt-months{display:flex; gap:10px; margin-bottom:16px;}
  .mt-m{flex:1; text-align:center; padding:12px 6px; font-family:var(--mono,'Inter',monospace); font-weight:700; font-size:13px; letter-spacing:.05em; border:1.5px solid var(--grey-line); color:var(--grey); cursor:pointer; transition:all .25s ease;}
  .mt-m.active{border-color:var(--red); color:var(--red); background:rgba(178,59,48,0.06);}
  .mt-readout{font-family:var(--serif); font-size:16px; color:var(--black); min-height:26px;}

  /* interactive: career ladder (chapter 9b) */
  .ladder{margin:22px 0; display:flex; flex-direction:column;}
  .ladder-step{display:grid; grid-template-columns:38px 1fr; gap:16px; padding:14px 4px; cursor:pointer; border-top:1px solid var(--grey-line); transition:background .25s ease;}
  .ladder-step:first-child{border-top:none;}
  .ladder-step:hover, .ladder-step:focus-visible{background:var(--off);}
  .ladder-dot{width:32px; height:32px; border-radius:50%; border:1.6px solid var(--black); display:flex; align-items:center; justify-content:center; font-family:var(--sans); font-weight:700; font-size:13px; color:var(--black);}
  .ladder-step.final .ladder-dot{background:var(--red); border-color:var(--red); color:var(--white);}
  .ladder-title{font-family:var(--serif); font-size:16.5px; color:var(--black); font-weight:600;}
  .ladder-detail{font-family:var(--sans); font-size:13.5px; color:var(--grey); line-height:1.65; max-height:0; overflow:hidden; transition:max-height .4s ease, margin-top .4s ease;}
  .ladder-step.open .ladder-detail{max-height:140px; margin-top:8px;}

  /* interactive: attendance grid (chapter 2) */
  .zoom-wrap{margin:24px 0; text-align:center;}
  .zoom-grid{display:grid; grid-template-columns:repeat(6,1fr); gap:6px; max-width:320px; margin:0 auto;}
  .zoom-tile{aspect-ratio:1; background:var(--off); border:1px solid var(--grey-line); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:background .25s ease;}
  .zoom-tile .dot{width:9px; height:9px; border-radius:50%; border:1.4px solid var(--grey); transition:all .25s ease;}
  .zoom-tile.off{background:var(--black);}
  .zoom-tile.off .dot{background:var(--red); border-color:var(--red);}
  .zoom-tile.me{outline:2px solid var(--red); outline-offset:-2px;}
  .zoom-cap{margin-top:16px; font-family:var(--sans); font-size:12px; color:var(--grey);}
  .zoom-hint{font-family:var(--sans); font-size:11px; color:#b4b0a6; margin-top:6px;}

  /* interactive: receipt mockup (chapter 5) */
  .receipt-wrap{margin:24px 0; display:flex; justify-content:center;}
  .receipt{width:280px; background:#fdfcf9; border:1px solid var(--grey-line); padding:22px 22px 30px; font-family:'Inter',monospace; font-size:11.5px; color:var(--black); position:relative; box-shadow:0 18px 40px rgba(10,10,10,0.08); transform:rotate(-1.4deg);}
  .receipt::after{content:""; position:absolute; left:0; right:0; bottom:-9px; height:16px; background:
    linear-gradient(-45deg, transparent 8px, #fdfcf9 8px) 0 0/16px 16px repeat-x,
    linear-gradient(45deg, transparent 8px, #fdfcf9 8px) 0 0/16px 16px repeat-x;
    filter:drop-shadow(0 3px 2px rgba(0,0,0,.05));}
  .receipt .r-head{text-align:center; font-weight:700; letter-spacing:.08em; border-bottom:1px dashed var(--grey-line); padding-bottom:10px; margin-bottom:10px;}
  .receipt .r-row{display:flex; justify-content:space-between; padding:4px 0; color:var(--text-soft, var(--grey));}
  .receipt .r-row b{color:var(--black); font-weight:600;}
  .receipt .r-stamp{position:absolute; top:38%; left:50%; transform:translate(-50%,-50%) rotate(-11deg); border:2px solid var(--red); color:var(--red); font-weight:700; font-size:13px; padding:6px 12px; letter-spacing:.04em; opacity:0; transition:opacity .5s ease .3s, transform .5s cubic-bezier(.3,1.4,.4,1) .3s;}
  .receipt-wrap.in .r-stamp{opacity:.92; transform:translate(-50%,-50%) rotate(-11deg) scale(1);}

  /* interactive: split-flap board (chapter 8) */
  .flap-wrap{margin:24px 0; text-align:center;}
  .flap-row{display:flex; gap:5px; justify-content:center; flex-wrap:wrap; margin-bottom:16px;}
  .flap{background:var(--black); color:var(--white); font-family:'Inter',monospace; font-weight:700; font-size:15px; padding:12px 8px; min-width:64px; text-align:center; border-radius:2px; letter-spacing:.02em;}
  .flap.wrong{color:#e8b8b2;}
  .flap.right{color:var(--white); background:var(--red);}
  .flap-btn{font-family:var(--sans); font-size:12.5px; font-weight:600; color:var(--black); background:none; border:1px solid var(--black); padding:10px 20px; border-radius:100px; cursor:pointer; transition:background .25s ease, color .25s ease;}
  .flap-btn:hover{background:var(--black); color:var(--white);}
  .flap-cap{margin-top:14px; font-family:var(--serif); font-size:15px; color:var(--black); min-height:22px;}

  /* stat break: full-bleed bold number moment between chapters */
  .stat-break{max-width:none; background:var(--black); color:var(--white); text-align:center; padding:min(10vh,90px) 24px;}
  .stat-break .sb-num{font-family:var(--serif); font-weight:700; font-size:clamp(56px,11vw,120px); line-height:1; color:var(--white);}
  .stat-break .sb-num .accent{color:var(--red);}
  .stat-break .sb-label{font-family:var(--sans); font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#8f8a76; margin-top:14px;}

  .route-tabs{display:flex; gap:1px; background:var(--grey-line); margin:22px 0;}
  .route-tab{flex:1; background:var(--white); padding:26px 20px; display:flex; align-items:center; gap:16px;}
  .route-tab.active{background:var(--black);}
  .rt-letter{font-family:var(--serif); font-weight:700; font-size:34px; color:var(--red); line-height:1; flex:none;}
  .route-tab.active .rt-letter{color:var(--red);}
  .rt-name{font-family:var(--sans); font-weight:600; font-size:14px; color:var(--black); line-height:1.35;}
  .route-tab.active .rt-name{color:var(--white);}

  .illus-strip{display:flex; gap:1px; background:var(--grey-line); margin:22px 0;}
  .illus-cell{flex:1; background:var(--white); padding:26px 18px 20px; text-align:center;}
  .illus-cell svg{margin:0 auto 12px;}
  .illus-cell .cap{font-family:var(--sans); font-size:12px; color:var(--grey); letter-spacing:.02em;}

  .card-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:1px; margin-top:22px; background:var(--grey-line);}
  .flip-card{background:var(--white); padding:26px 22px; cursor:pointer; min-height:110px; display:flex; flex-direction:column; justify-content:center; gap:8px; transition:background .3s ease;}
  .flip-card:hover, .flip-card:focus-visible{background:var(--off);}
  .flip-card .front-text{font-family:var(--serif); font-size:16.5px; color:var(--black); text-align:left;}
  .flip-card .back-text{font-family:var(--sans); font-size:13px; color:var(--grey); display:none; line-height:1.6; text-align:left;}
  .flip-card.flipped{background:var(--black);}
  .flip-card.flipped .front-text{color:var(--red);}
  .flip-card.flipped .back-text{display:block; color:#bcbcbc;}
  .hint{font-family:var(--sans); font-size:11px; color:var(--grey); margin-top:12px;}

  .timeline{display:flex; flex-direction:column; gap:0; margin:20px 0;}
  .timeline .step{display:grid; grid-template-columns:16px 1fr; gap:18px; padding:16px 0; position:relative;}
  .timeline .step::before{content:""; position:absolute; left:7px; top:0; bottom:0; width:1px; background:var(--grey-line);}
  .timeline .step:first-child::before{top:16px;}
  .timeline .step:last-child::before{bottom:calc(100% - 16px);}
  .dot{width:16px; height:16px; border-radius:50%; background:var(--white); border:2px solid var(--black); z-index:1;}
  .dot.filled{background:var(--black);}
  .step-label{font-family:var(--sans); font-weight:600; font-size:15px; color:var(--black); margin-bottom:2px; text-align:left;}
  .step-sub{color:var(--grey); font-size:14px; font-family:var(--sans); text-align:left;}

  .split{display:grid; grid-template-columns:1fr; gap:1px; margin-top:20px; background:var(--grey-line);}
  @media(min-width:680px){.split{grid-template-columns:1fr 1fr;}}
  .split > div{padding:30px 28px; background:var(--white);}
  .split .real{background:var(--black); color:var(--white);}
  .split h4{font-family:var(--sans); font-size:11px; text-transform:uppercase; letter-spacing:.12em; margin:0 0 18px; color:var(--grey); font-weight:600;}
  .split .real h4{color:#9a9a9a;}
  .split ul{margin:0; padding:0; list-style:none;}
  .split li{padding:10px 0; border-top:1px solid var(--grey-line); font-size:15px; font-family:var(--serif); text-align:left;}
  .split .real li{border-top:1px solid rgba(255,255,255,0.12);}
  .split li:first-child{border-top:none;}

  .checklist{margin:20px 0; display:flex; flex-direction:column; gap:14px; max-width:400px;}
  .check-item{display:flex; align-items:center; gap:12px; font-family:var(--sans); font-size:15px; opacity:0; transform:translateX(-10px); transition:opacity .5s ease, transform .5s ease;}
  .check-item.in{opacity:1; transform:translateX(0);}
  .check-item .mark{width:18px; text-align:center; font-weight:700;}
  .check-item.no .mark{color:var(--red);}
  .check-item.yes .mark{color:var(--black);}
  .check-item.yes{font-weight:600;}

  .counter-wrap{text-align:center; margin:24px 0;}
  .counter{font-family:var(--sans); font-size:clamp(24px,4.4vw,42px); color:var(--black); font-weight:700; letter-spacing:-.01em;}
  .counter-label{font-family:var(--sans); font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:var(--grey); margin-top:10px;}

  .panic-wrap{margin:22px 0; background:var(--off); padding:24px 26px;}
  .panic-wrap label{font-family:var(--sans); font-size:12px; color:var(--grey); font-weight:600;}
  #panic-slider{width:100%; margin:18px 0 10px; accent-color:var(--red);}
  #panic-readout{font-family:var(--serif); font-size:17px; color:var(--black); min-height:26px; text-align:left;}
  .panic-scale{display:flex; justify-content:space-between; font-family:var(--sans); font-size:11px; color:var(--grey);}

  .struggle-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:1px; margin-top:20px; background:var(--grey-line);}
  .struggle-card{background:var(--white); padding:24px; cursor:pointer; transition:background .3s ease;}
  .struggle-card:hover, .struggle-card:focus-visible{background:var(--off);}
  .struggle-card .title{font-family:var(--sans); font-weight:600; font-size:15px; color:var(--black); margin-bottom:6px; display:flex; justify-content:space-between; align-items:center; text-align:left;}
  .struggle-card .body{max-height:0; overflow:hidden; transition:max-height .4s ease; font-size:14px; color:var(--grey); line-height:1.7; text-align:left; font-family:var(--serif);}
  .struggle-card.open .body{max-height:220px; margin-top:10px;}
  .struggle-card .plus{font-family:var(--sans); color:var(--red); font-size:16px; transition:transform .3s ease;}
  .struggle-card.open .plus{transform:rotate(45deg);}

  .lesson-block{margin-top:26px;}
  .lesson-num{font-family:var(--sans); font-size:12px; color:var(--red); letter-spacing:.1em; font-weight:600;}
  .lesson-title{font-family:var(--serif); font-size:24px; margin:8px 0 14px; color:var(--black); text-align:left;}
  .quote-block{border-left:2px solid var(--red); padding-left:22px; margin:22px 0; font-family:var(--serif); font-size:19px; color:var(--black); line-height:1.75; text-align:left;}

  .advice-list{margin-top:20px; display:flex; flex-direction:column; gap:0;}
  .advice-item{padding:22px 0; border-top:1px solid var(--grey-line); display:grid; grid-template-columns:32px 1fr; gap:16px;}
  .advice-item:last-child{border-bottom:1px solid var(--grey-line);}
  .advice-item .n{font-family:var(--sans); color:var(--red); font-weight:700; font-size:14px;}
  .advice-item .h{font-family:var(--sans); font-weight:600; font-size:16px; color:var(--black); margin-bottom:5px; text-align:left;}
  .advice-item p{margin:0; font-size:14.5px; text-align:left; font-family:var(--sans); color:var(--grey); line-height:1.65;}

  .tips-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1px; margin-top:20px; background:var(--grey-line);}
  .tip-card{background:var(--white); padding:26px 24px;}
  .tip-icon{width:34px; height:34px; margin-bottom:16px;}
  .tip-title{font-family:var(--sans); font-weight:700; font-size:15px; color:var(--black); margin-bottom:8px; text-align:left;}
  .tip-body{font-family:var(--sans); font-size:13.5px; color:var(--grey); line-height:1.7; text-align:left;}
  .tip-body b{color:var(--black);}

  .doc-checklist{margin:22px 0; border:1px solid var(--grey-line);}
  .doc-row{display:grid; grid-template-columns:22px 1fr auto; align-items:center; gap:14px; padding:14px 18px; border-top:1px solid var(--grey-line); font-family:var(--sans); font-size:13.5px;}
  .doc-row:first-child{border-top:none;}
  .doc-row .num{width:22px; height:22px; border:1.5px solid var(--black); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:var(--black); flex:none;}
  .doc-row .dname{color:var(--black); font-weight:600;}
  .doc-row .dnote{color:var(--grey); font-size:12.5px; display:block; margin-top:2px; font-weight:400;}
  .doc-row .dtag{font-size:10.5px; color:var(--red); border:1px solid var(--red); padding:3px 8px; border-radius:20px; white-space:nowrap; text-transform:uppercase; letter-spacing:.04em;}

  .budget-wrap{margin:22px 0;}
